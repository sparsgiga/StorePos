<Window x:Class="StorePos.Desktop.Products.Views.ProductEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="560" Height="575"
        MinWidth="500" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Margin="0,7" Text="დასახელება" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                 MaxLength="300" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Margin="0,7" Text="კოდი" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                 MaxLength="50" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Margin="0,7" Text="შტრიხკოდი" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3,7,3"
                 MaxLength="100" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="2" Grid.Column="2" MinWidth="38" Margin="0,3" Padding="8,3"
                Command="{Binding GenerateBarcodeCommand}" Content="↻"
                ToolTip="შტრიხკოდის გენერაცია მიმდინარე კოდიდან" />

        <TextBlock Grid.Row="3" Margin="0,7" Text="საზომი ერთეული" />
        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                  ItemsSource="{Binding MeasurementUnits}"
                  SelectedItem="{Binding SelectedMeasurementUnit}"
                  DisplayMemberPath="Name" />

        <TextBlock Grid.Row="4" Margin="0,7" Text="გამყიდველი" />
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                 MaxLength="300" Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="5" Margin="0,7" Text="მომწოდებლის კოდი" />
        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                 MaxLength="100" Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6" Margin="0,7" FontWeight="SemiBold" Text="პირველადი ფასი" />
        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                 Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="7" Margin="0,7" FontWeight="SemiBold" Text="საცალო ფასი" />
        <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                 Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Margin="0,12,0,8"
                   Foreground="#B42318" TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}" />

        <StackPanel Grid.Row="9" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button MinWidth="105" Margin="0,0,8,0" Padding="12,6"
                    Command="{Binding SaveCommand}" Content="შენახვა" />
            <Button MinWidth="95" Padding="12,6"
                    Command="{Binding CancelCommand}" Content="გაუქმება" />
        </StackPanel>
    </Grid>
</Window>
