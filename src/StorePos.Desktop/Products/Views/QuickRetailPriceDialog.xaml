<Window x:Class="StorePos.Desktop.Products.Views.QuickRetailPriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="საცალო ფასის მითითება"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=PriceTextBox}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,14"
                   FontSize="15"
                   Text="პროდუქტს საცალო ფასი არ აქვს მითითებული."
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="{Binding ProductName}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0" Foreground="#526173">
                <Run Text="კოდი: " />
                <Run Text="{Binding ProductCode, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,5"
                       FontWeight="SemiBold"
                       Text="საცალო ფასი" />
            <TextBox x:Name="PriceTextBox"
                     Padding="10,8"
                     FontSize="18"
                     Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   MinHeight="20"
                   Margin="0,0,0,12"
                   Foreground="#B42318"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="14,7"
                    Command="{Binding CancelCommand}"
                    Content="გაუქმება"
                    IsCancel="True" />
            <Button MinWidth="180"
                    Padding="14,7"
                    Command="{Binding SaveCommand}"
                    Content="შენახვა და დამატება"
                    FontWeight="SemiBold"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
