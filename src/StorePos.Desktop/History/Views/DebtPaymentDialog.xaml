<Window x:Class="StorePos.Desktop.History.Views.DebtPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ვალის გადახდა"
        Width="390"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="10,8"
                Background="#F4F5F7" CornerRadius="5">
            <DockPanel>
                <TextBlock Text="დარჩენილი ვალი" />
                <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="Bold"
                           Text="{Binding OutstandingAmount, StringFormat={}{0:N2} ₾}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="თანხა" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Padding="7,5"
                     Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="გადახდის ტიპი" />
            <ComboBox Grid.Row="1" Grid.Column="1" Padding="6,4"
                      ItemsSource="{Binding PaymentTypes}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedPaymentType}" />
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,0,0,10" Foreground="#B42318"
                   Text="{Binding ErrorMessage}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="95" Margin="0,0,8,0" Padding="12,6"
                    Command="{Binding CancelCommand}" Content="გაუქმება" IsCancel="True" />
            <Button MinWidth="95" Padding="12,6" Command="{Binding PayCommand}"
                    Content="გადახდა" IsDefault="True" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
