<Window x:Class="StorePos.Desktop.History.Views.SaleDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="გაყიდვის დეტალები"
        Width="960"
        Height="650"
        MinWidth="760"
        MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBox VerticalAlignment="Center"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="22"
                             FontWeight="SemiBold"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             Text="{Binding SaleNumber, Mode=OneWay}" />
                    <Button Margin="8,0,0,0" Padding="7,2"
                            Command="{Binding CopySaleNumberCommand}"
                            Content="კოპირება"
                            ToolTip="გაყიდვის ნომრის კოპირება" />
                </StackPanel>
                <TextBlock Margin="0,3,0,0" Foreground="#5F6B7A" Text="{Binding StatusName}" />
            </StackPanel>
            <Grid DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,10,2" Text="ჯამი" />
                <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"
                           Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
                <TextBlock Grid.Row="1" Margin="0,0,10,2" Text="გადახდილი" />
                <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"
                           Text="{Binding PaidAmount, StringFormat={}{0:N2} ₾}" />
                <TextBlock Grid.Row="2" Margin="0,0,10,0" Text="ვალი" />
                <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"
                           Text="{Binding OutstandingAmount, StringFormat={}{0:N2} ₾}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDebt}" Value="True">
                                    <Setter Property="Foreground" Value="#B42318" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,0,0,12" Padding="10"
                Background="#F4F5F7" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="მყიდველი" />
                    <TextBlock Text="{Binding CustomerName, TargetNullValue=არ არის მითითებული}" />
                    <TextBlock Foreground="#5F6B7A" Text="{Binding CustomerIdentificationNumber}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="თარიღები" />
                    <TextBlock Text="{Binding DateCreated, StringFormat=შექმნა: {0:dd.MM.yyyy HH:mm}}" />
                    <TextBlock Text="{Binding DateCompleted, StringFormat=დასრულება: {0:dd.MM.yyyy HH:mm}}" />
                    <TextBlock Text="{Binding DateCancelled, StringFormat=გაუქმება: {0:dd.MM.yyyy HH:mm}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="კომენტარი" />
                    <TextBlock MaxHeight="58" Text="{Binding Comment}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="პროდუქცია">
                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          IsReadOnly="True"
                          RowHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" MinWidth="200" Header="დასახელება" Binding="{Binding ProductName}" />
                        <DataGridTextColumn Width="120" Header="კოდი" Binding="{Binding ProductCode}" />
                        <DataGridTextColumn Width="120" Header="ბარკოდი" Binding="{Binding Barcode}" />
                        <DataGridTextColumn Width="90" Header="ერთეული" Binding="{Binding UnitName}" />
                        <DataGridTextColumn Width="100" Header="რაოდენობა" Binding="{Binding Quantity, StringFormat={}{0:N5}}" />
                        <DataGridTextColumn Width="100" Header="ფასი" Binding="{Binding UnitPrice, StringFormat={}{0:N5}}" />
                        <DataGridTextColumn Width="105" Header="ჯამი" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" />
                        <DataGridTextColumn Width="85" Header="ტიპი" Binding="{Binding SourceName}" />
                        <DataGridTextColumn Width="160" Header="კომენტარი" Binding="{Binding Comment}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="გადახდები">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PaymentGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,8,8,12">
                                    <TextBlock Margin="0,0,0,6"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding Header}" />
                                    <DataGrid ItemsSource="{Binding Payments}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              RowHeight="30"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="150" Header="თარიღი"
                                                                Binding="{Binding DateCreated, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                                            <DataGridTextColumn Width="*" Header="გადახდის ტიპი" Binding="{Binding PaymentTypeName}" />
                                            <DataGridTextColumn Width="150" Header="დანიშნულება" Binding="{Binding PaymentKindName}" />
                                            <DataGridTextColumn Width="130" Header="თანხა" Binding="{Binding Amount, StringFormat={}{0:N2}}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="105" Margin="0,0,8,0" Padding="12,6"
                    Command="{Binding PrintCommand}" Content="ბეჭდვა" />
            <Button MinWidth="125" Margin="0,0,8,0" Padding="12,6"
                    Command="{Binding PayDebtCommand}" Content="ვალის გადახდა">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDebt}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button MinWidth="100" Padding="12,6" IsCancel="True" Content="დახურვა" />
        </StackPanel>
    </Grid>
</Window>
