<Window x:Class="StorePos.Desktop.History.Views.SaleDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="გაყიდვის დეტალები"
        Width="960"
        Height="650"
        MinWidth="760"
        MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SaleNumber}" />
                <TextBlock Margin="0,3,0,0" Foreground="#5F6B7A" Text="{Binding StatusName}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Right" Text="ჯამი" />
                <TextBlock FontSize="23" FontWeight="Bold"
                           Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,0,0,12" Padding="10"
                Background="#F4F5F7" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="მყიდველი" />
                    <TextBlock Text="{Binding CustomerName, TargetNullValue=არ არის მითითებული}" />
                    <TextBlock Foreground="#5F6B7A" Text="{Binding CustomerIdentificationNumber}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="თარიღები" />
                    <TextBlock Text="{Binding DateCreated, StringFormat=შექმნა: {0:dd.MM.yyyy HH:mm}}" />
                    <TextBlock Text="{Binding DateCompleted, StringFormat=დასრულება: {0:dd.MM.yyyy HH:mm}}" />
                    <TextBlock Text="{Binding DateCancelled, StringFormat=გაუქმება: {0:dd.MM.yyyy HH:mm}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="კომენტარი" />
                    <TextBlock MaxHeight="58" Text="{Binding Comment}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="პროდუქცია">
                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          IsReadOnly="True"
                          RowHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" MinWidth="200" Header="დასახელება" Binding="{Binding ProductName}" />
                        <DataGridTextColumn Width="120" Header="კოდი" Binding="{Binding ProductCode}" />
                        <DataGridTextColumn Width="120" Header="ბარკოდი" Binding="{Binding Barcode}" />
                        <DataGridTextColumn Width="90" Header="ერთეული" Binding="{Binding UnitName}" />
                        <DataGridTextColumn Width="100" Header="რაოდენობა" Binding="{Binding Quantity, StringFormat={}{0:N5}}" />
                        <DataGridTextColumn Width="100" Header="ფასი" Binding="{Binding UnitPrice, StringFormat={}{0:N5}}" />
                        <DataGridTextColumn Width="105" Header="ჯამი" Binding="{Binding LineTotal, StringFormat={}{0:N5}}" />
                        <DataGridTextColumn Width="85" Header="ტიპი" Binding="{Binding SourceName}" />
                        <DataGridTextColumn Width="160" Header="კომენტარი" Binding="{Binding Comment}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="გადახდები">
                <DataGrid ItemsSource="{Binding Payments}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Header="გადახდის ტიპი" Binding="{Binding PaymentTypeName}" />
                        <DataGridTextColumn Width="180" Header="თანხა" Binding="{Binding Amount, StringFormat={}{0:N5}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="3" MinWidth="100" Margin="0,12,0,0" Padding="12,6"
                HorizontalAlignment="Right" IsCancel="True" Content="დახურვა" />
    </Grid>
</Window>
