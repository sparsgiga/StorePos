<UserControl x:Class="StorePos.Desktop.History.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16" Background="#F4F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="გაყიდვების ისტორია" />

        <Border Grid.Row="1" Padding="10" Background="White" CornerRadius="5">
            <WrapPanel VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,3" Text="თარიღიდან" />
                    <DatePicker Width="135" SelectedDate="{Binding DateFrom}" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,3" Text="თარიღამდე" />
                    <DatePicker Width="135" SelectedDate="{Binding DateTo}" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,3" Text="სტატუსი" />
                    <ComboBox Width="135"
                              ItemsSource="{Binding StatusOptions}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedStatus}" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,3" Text="გაყიდვა" />
                    <TextBox Width="150" Padding="6,4" Text="{Binding SaleNumber}" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Margin="0,0,0,3" Text="მყიდველი" />
                    <TextBox Width="180" Padding="6,4" Text="{Binding CustomerName}" />
                </StackPanel>
                <Button MinWidth="90"
                        Margin="0,19,0,0"
                        Padding="12,5"
                        Command="{Binding SearchCommand}"
                        Content="ძებნა"
                        FontWeight="SemiBold" />
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,7"
                   Foreground="#B42318"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  IsReadOnly="True"
                  MouseDoubleClick="OnRowDoubleClick"
                  RowHeight="28"
                  SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDebt}" Value="True">
                            <Setter Property="Background" Value="#FFF0F0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Width="135" Header="თარიღი" Binding="{Binding RelevantDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                <DataGridTextColumn Width="135" Header="გაყიდვა" Binding="{Binding SaleNumber}" />
                <DataGridTextColumn Width="*" MinWidth="150" Header="მყიდველი" Binding="{Binding CustomerName}" />
                <DataGridTextColumn Width="105" Header="გადახდილი" Binding="{Binding PaidAmount, StringFormat={}{0:N2}}" />
                <DataGridTextColumn Width="105" Header="ვალი" Binding="{Binding OutstandingAmount, StringFormat={}{0:N2}}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDebt}" Value="True">
                                    <Setter Property="Foreground" Value="#B42318" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="105" Header="ჯამი" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" />
                <DataGridTextColumn Width="105" Header="სტატუსი" Binding="{Binding StatusName}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button MinWidth="100" Margin="0,0,8,0" Padding="10,5"
                        Command="{Binding OpenDetailsCommand}" Content="დეტალები" />
                <Button MinWidth="150" Padding="10,5"
                        Command="{Binding ReopenCommand}" Content="Draft-ზე დაბრუნება" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="38" Command="{Binding PreviousPageCommand}" Content="&lt;" />
                <TextBlock MinWidth="70" Margin="8,0" VerticalAlignment="Center"
                           TextAlignment="Center" Text="{Binding PageLabel}" />
                <Button Width="38" Command="{Binding NextPageCommand}" Content="&gt;" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#5F6B7A" Text="{Binding TotalCount, StringFormat=ნაპოვნია: {0}}" />
        </DockPanel>
    </Grid>
</UserControl>
