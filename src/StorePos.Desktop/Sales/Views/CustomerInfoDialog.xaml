<Window x:Class="StorePos.Desktop.Sales.Views.CustomerInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="მყიდველის ინფორმაცია"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4" Text="მყიდველის სახელი / დასახელება" />
            <TextBox Padding="8,6"
                     MaxLength="300"
                     Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4" Text="პირადი / საიდენტიფიკაციო ნომერი" />
            <TextBox Padding="8,6"
                     MaxLength="50"
                     Text="{Binding CustomerIdentificationNumber, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4" Text="კომენტარი" />
            <TextBox MinHeight="70"
                     Padding="8,6"
                     AcceptsReturn="True"
                     MaxLength="4000"
                     Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,0,0,12"
                   Foreground="#B42318"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="14,7"
                    Command="{Binding CancelCommand}"
                    Content="გაუქმება"
                    IsCancel="True" />
            <Button MinWidth="100"
                    Padding="14,7"
                    Command="{Binding SaveCommand}"
                    Content="შენახვა"
                    IsDefault="True"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
