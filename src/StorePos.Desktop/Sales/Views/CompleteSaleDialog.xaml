<Window x:Class="StorePos.Desktop.Sales.Views.CompleteSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="გაყიდვის დასრულება"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="12,9"
                Background="#F4F5F7"
                CornerRadius="5">
            <DockPanel>
                <TextBlock FontSize="16" Text="ჯამი" />
                <TextBlock HorizontalAlignment="Right"
                           FontSize="21"
                           FontWeight="Bold"
                           Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="135" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="ნაღდი" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Padding="8,6"
                     Text="{Binding CashAmount, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="ბარათი" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Padding="8,6"
                     Text="{Binding CardAmount, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="გადარიცხვა" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Padding="8,6"
                     Text="{Binding BankTransferAmount, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="სხვა" />
            <TextBox Grid.Row="3" Grid.Column="1" Padding="8,6"
                     Text="{Binding OtherAmount, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="12,9"
                BorderBrush="#D9DDE3"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="გადახდილი" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           FontWeight="SemiBold"
                           Text="{Binding PaidAmount, StringFormat={}{0:N2} ₾}" />
                <TextBlock Grid.Row="1" Margin="0,6,0,0" Text="დარჩენილი" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                           FontWeight="SemiBold"
                           Text="{Binding RemainingAmount, StringFormat={}{0:N2} ₾}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,0,0,12"
                   Foreground="#B42318"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="14,7"
                    Command="{Binding CancelCommand}"
                    Content="გაუქმება"
                    IsCancel="True" />
            <Button MinWidth="110"
                    Padding="14,7"
                    Command="{Binding CompleteCommand}"
                    Content="დასრულება"
                    IsDefault="True"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
