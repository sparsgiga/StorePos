<Window x:Class="StorePos.Desktop.Sales.Views.EditSaleItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="პროდუქტის რედაქტირება"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4" Text="დასახელება" />
            <TextBox Padding="8,6"
                     MaxLength="300"
                     Text="{Binding Input.ProductName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Margin="0,0,0,4" Text="რაოდენობა" />
                <TextBox Padding="8,6"
                         IsReadOnly="{Binding Input.IsQuantityReadOnly}"
                         Text="{Binding Input.Quantity, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Margin="0,0,0,4" Text="ფასი" />
                <TextBox Padding="8,6"
                         IsReadOnly="{Binding Input.IsUnitPriceReadOnly}"
                         Text="{Binding Input.UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,4" Text="ჯამი" />
                <TextBox Padding="8,6"
                         IsReadOnly="{Binding Input.IsLineTotalReadOnly}"
                         Text="{Binding Input.LineTotal, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4" Text="კომენტარი" />
            <TextBox MinHeight="58"
                     Padding="8,6"
                     AcceptsReturn="True"
                     MaxLength="500"
                     Text="{Binding Input.Comment, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,0,0,12"
                   Foreground="#B42318"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="14,7"
                    Command="{Binding CancelCommand}"
                    Content="გაუქმება"
                    IsCancel="True" />
            <Button MinWidth="100"
                    Padding="14,7"
                    Command="{Binding SaveCommand}"
                    Content="შენახვა"
                    IsDefault="True"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
