<UserControl x:Class="StorePos.Desktop.Sales.Views.SalesWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">
    <Grid Background="#F4F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,14"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="ღია გაყიდვები" />

                <Button DockPanel.Dock="Right"
                        MinWidth="170"
                        Padding="16,9"
                        HorizontalAlignment="Right"
                        Command="{Binding NewSaleCommand}"
                        Content="+ ახალი გაყიდვა"
                        FontSize="15"
                        FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="18,10,18,0"
                   Foreground="#B42318"
                   FontSize="14"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="18,12,18,14">
            <TabControl ItemsSource="{Binding OpenSales}"
                        SelectedItem="{Binding SelectedSale}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,4">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding SaleNumber}" />
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="#5F6B7A"
                                       FontSize="11"
                                       Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding SaleNumber}" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="#5F6B7A"
                                           Text="{Binding DateCreated, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="#5F6B7A"
                                           Text="{Binding CustomerName, TargetNullValue=მომხმარებელი მითითებული არ არის}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#7A8491"
                                       FontSize="18"
                                       Text="გაყიდვა ცარიელია" />

                            <Border Grid.Row="2"
                                    Padding="16"
                                    Background="#F8F9FB"
                                    CornerRadius="6">
                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="18"
                                               Text="ჯამი:" />
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#7A8491"
                       FontSize="18"
                       Text="ღია გაყიდვები არ არის">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OpenSales.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border Grid.Row="3"
                Padding="18,8"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Foreground="#5F6B7A"
                           Text="{Binding OpenSales.Count, StringFormat=ღია გაყიდვები: {0}}" />
                <TextBlock DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Foreground="#5F6B7A"
                           Text="მონაცემები ინახება სერვერზე" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
