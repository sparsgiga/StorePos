<UserControl x:Class="StorePos.Desktop.Sales.Views.SalesWorkspaceView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:StorePos.Desktop.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400">
    <UserControl.Resources>
        <common:DecimalDisplayConverter x:Key="DecimalDisplayConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="RightAlignedCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16,10"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        MinWidth="135"
                        Margin="14,0,0,0"
                        Padding="14,7"
                        Command="{Binding NewSaleCommand}"
                        Content="+ ახალი გაყიდვა"
                        FontWeight="SemiBold" />

                <Button DockPanel.Dock="Right"
                        MinWidth="90"
                        Margin="10,0,0,0"
                        Padding="12,6"
                        Command="{Binding EditCustomerCommand}"
                        Content="შეცვლა" />

                <StackPanel DockPanel.Dock="Right"
                            MaxWidth="360"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="მყიდველი:" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding SelectedSale.CustomerName, TargetNullValue=არ არის მითითებული}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedSale.CustomerName}" />
                </StackPanel>

                <TextBlock VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="გაყიდვები" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="16,7,16,0"
                   Foreground="#B42318"
                   FontSize="13"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="16,8,16,10">
            <TabControl ItemsSource="{Binding OpenSales}"
                        SelectedItem="{Binding SelectedSale}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="165"
                                    Margin="7,3"
                                    ToolTip="{Binding CustomerName}">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding SaleNumber}" />
                            <TextBlock Margin="0,1,0,0"
                                       Foreground="#5F6B7A"
                                       Text="{Binding CustomerName, TargetNullValue=—}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,1,0,0"
                                       Foreground="#344054"
                                       FontSize="11"
                                       Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="#EEF6FB"
                                    BorderBrush="#B8D8EA"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Margin="0,0,0,3"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="პროდუქტის ძებნა — შტრიხკოდი, კოდი ან დასახელება" />
                                        <TextBox Tag="CatalogProductSearch"
                                                 Padding="8,6"
                                                 Text="{Binding DataContext.ProductSearch.Query, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding DataContext.ProductSearch.EnterCommand, Source={x:Reference Root}}" />
                                                <KeyBinding Key="Up" Command="{Binding DataContext.ProductSearch.MoveUpCommand, Source={x:Reference Root}}" />
                                                <KeyBinding Key="Down" Command="{Binding DataContext.ProductSearch.MoveDownCommand, Source={x:Reference Root}}" />
                                                <KeyBinding Key="Escape" Command="{Binding DataContext.ProductSearch.ClearCommand, Source={x:Reference Root}}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            MinWidth="105"
                                            Padding="14,6"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding DataContext.ProductSearch.AddSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="დამატება"
                                            FontWeight="SemiBold" />

                                    <ListBox Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             MaxHeight="155"
                                             Margin="0,8,0,0"
                                             ItemsSource="{Binding DataContext.ProductSearch.Results, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             SelectedItem="{Binding DataContext.ProductSearch.SelectedProduct, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                             Visibility="{Binding DataContext.ProductSearch.HasResults, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinWidth="820" Margin="5,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Code}" />
                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="2" Foreground="#5F6B7A" Text="{Binding Barcode, TargetNullValue=—}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding MeasurementUnitShortName, TargetNullValue=—}" />
                                                    <TextBlock Grid.Column="4"
                                                               HorizontalAlignment="Right"
                                                               Text="{Binding Price, Converter={StaticResource DecimalDisplayConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="#F8F9FB"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Row="0"
                                              Grid.ColumnSpan="6"
                                              Margin="0,0,0,8"
                                              Content="პროდუქტის კატალოგში შენახვა"
                                              IsChecked="{Binding DataContext.ManualItemInput.SaveToCatalog, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Margin="0,0,0,3" FontSize="11" Text="დასახელება" />
                                        <TextBox Tag="ManualProductName"
                                                 Padding="7,5"
                                                 MaxLength="300"
                                                 Text="{Binding DataContext.ManualItemInput.ProductName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Margin="0,0,0,3" FontSize="11" Text="რაოდენობა" />
                                        <TextBox Padding="7,5"
                                                 IsReadOnly="{Binding DataContext.ManualItemInput.IsQuantityReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Text="{Binding DataContext.ManualItemInput.Quantity, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Margin="0,0,0,3" FontSize="11" Text="ფასი" />
                                        <TextBox Padding="7,5"
                                                 IsReadOnly="{Binding DataContext.ManualItemInput.IsUnitPriceReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Text="{Binding DataContext.ManualItemInput.UnitPrice, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Margin="0,0,0,3" FontSize="11" Text="ჯამი" />
                                        <TextBox Padding="7,5"
                                                 IsReadOnly="{Binding DataContext.ManualItemInput.IsLineTotalReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Text="{Binding DataContext.ManualItemInput.LineTotal, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,8,0">
                                        <TextBlock Margin="0,0,0,3" FontSize="11" Text="კომენტარი" />
                                        <TextBox Padding="7,5"
                                                 MaxLength="500"
                                                 Text="{Binding DataContext.ManualItemInput.Comment, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Button Grid.Row="1" Grid.Column="5"
                                            MinWidth="105"
                                            Padding="14,6"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding DataContext.AddManualItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="დამატება"
                                            FontWeight="SemiBold" />

                                    <Grid Grid.Row="2"
                                          Grid.ColumnSpan="6"
                                          Margin="0,9,0,0"
                                          Visibility="{Binding DataContext.ManualItemInput.IsCatalogDetailsVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Margin="0,0,0,3" FontSize="11" Text="შტრიხკოდი (არასავალდებულო)" />
                                            <TextBox Padding="7,5"
                                                     MaxLength="100"
                                                     Text="{Binding DataContext.ManualItemInput.Barcode, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Margin="0,0,0,3" FontSize="11" Text="საზომი ერთეული" />
                                            <ComboBox Padding="6,4"
                                                      DisplayMemberPath="DisplayName"
                                                      ItemsSource="{Binding DataContext.ManualItemInput.MeasurementUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding DataContext.ManualItemInput.SelectedMeasurementUnit, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="#5F6B7A"
                                                   FontSize="11"
                                                   Text="კოდი ავტომატურად შეიქმნება სერვერზე." />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <DataGrid ItemsSource="{Binding Items}"
                                          SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          ColumnHeaderHeight="30"
                                          EnableColumnVirtualization="True"
                                          EnableRowVirtualization="True"
                                          HeadersVisibility="Column"
                                          IsReadOnly="True"
                                          PreviewKeyDown="OnSaleItemsPreviewKeyDown"
                                          RowHeight="28"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="3*"
                                                            MinWidth="220"
                                                            Header="დასახელება"
                                                            Binding="{Binding ProductName}" />
                                        <DataGridTextColumn Width="115"
                                                            ElementStyle="{StaticResource RightAlignedCellText}"
                                                            Header="რაოდენობა"
                                                            Binding="{Binding Quantity, Converter={StaticResource DecimalDisplayConverter}}" />
                                        <DataGridTextColumn Width="115"
                                                            ElementStyle="{StaticResource RightAlignedCellText}"
                                                            Header="ფასი"
                                                            Binding="{Binding UnitPrice, Converter={StaticResource DecimalDisplayConverter}}" />
                                        <DataGridTextColumn Width="125"
                                                            ElementStyle="{StaticResource RightAlignedCellText}"
                                                            Header="ჯამი"
                                                            Binding="{Binding LineTotal, Converter={StaticResource DecimalDisplayConverter}}" />
                                        <DataGridTextColumn Width="2*"
                                                            MinWidth="180"
                                                            Header="კომენტარი"
                                                            Binding="{Binding Comment}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#7A8491"
                                           FontSize="17"
                                           IsHitTestVisible="False"
                                           Text="გაყიდვა ცარიელია">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Border Grid.Row="3"
                                    Margin="0,8,0,0"
                                    Padding="10,8"
                                    Background="#F8F9FB"
                                    CornerRadius="5">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button MinWidth="110"
                                                Margin="0,0,8,0"
                                                Padding="12,6"
                                                Command="{Binding DataContext.EditSelectedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="რედაქტირება (F2)" />
                                        <Button MinWidth="100"
                                                Padding="12,6"
                                                Command="{Binding DataContext.RemoveSelectedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="წაშლა (Delete)" />
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button MinWidth="140"
                                                Margin="0,0,8,0"
                                                Padding="12,6"
                                                Command="{Binding DataContext.CancelSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="გაყიდვის გაუქმება" />
                                        <Button MinWidth="150"
                                                Margin="0,0,16,0"
                                                Padding="14,6"
                                                Background="#16794A"
                                                BorderBrush="#12683F"
                                                Command="{Binding DataContext.CompleteSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="გაყიდვის დასრულება"
                                                Foreground="White"
                                                FontWeight="SemiBold" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="17"
                                                   Text="ჯამი:" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="23"
                                                   FontWeight="Bold"
                                                   Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#7A8491"
                       FontSize="18"
                       IsHitTestVisible="False"
                       Text="ღია გაყიდვები არ არის">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OpenSales.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border Grid.Row="3"
                Padding="16,6"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Foreground="#5F6B7A"
                           Text="მონაცემები ინახება სერვერზე" />
                <TextBlock Foreground="#5F6B7A"
                           Text="{Binding OpenSales.Count, StringFormat=ღია გაყიდვები: {0}}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
