<UserControl x:Class="StorePos.Desktop.Sales.Views.SalesWorkspaceView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:StorePos.Desktop.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400">
    <UserControl.Resources>
        <common:DecimalDisplayConverter x:Key="DecimalDisplayConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="RightAlignedCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TrimmedCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,6"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        MinWidth="135"
                        Margin="14,0,0,0"
                        Padding="12,5"
                        Command="{Binding NewSaleCommand}"
                        Content="+ ახალი გაყიდვა"
                        FontWeight="SemiBold" />

                <Button DockPanel.Dock="Right"
                        MinWidth="90"
                        Margin="10,0,0,0"
                        Padding="10,4"
                        Command="{Binding EditCustomerCommand}"
                        Content="შეცვლა" />

                <Border DockPanel.Dock="Right"
                        MaxWidth="390"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FDECEC" />
                            <Setter Property="BorderBrush" Value="#D92D20" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSale.HasAssignedCustomer}" Value="True">
                                    <Setter Property="Background" Value="#E8F7EE" />
                                    <Setter Property="BorderBrush" Value="#16794A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" FontWeight="SemiBold" Text="მყიდველი:" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding SelectedSale.CustomerStatusText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedSale.CustomerStatusText}" />
                    </StackPanel>
                </Border>

                <TextBlock VerticalAlignment="Center"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Text="გაყიდვები" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="10,4,10,0"
                   Foreground="#B42318"
                   FontSize="13"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="10,4,10,6">
            <TabControl ItemsSource="{Binding OpenSales}"
                        SelectedItem="{Binding SelectedSale}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="155"
                                    Margin="5,2"
                                    ToolTip="{Binding CustomerName}">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding SaleNumber}" />
                            <DockPanel Margin="0,1,0,0">
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="6,0,0,0"
                                           Foreground="#344054"
                                           FontSize="11"
                                           Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
                                <TextBlock Foreground="#5F6B7A"
                                           Text="{Binding CustomerName, TargetNullValue=—}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Margin="0,0,0,4"
                                    Padding="6"
                                    Background="#EEF6FB"
                                    BorderBrush="#B8D8EA"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Margin="0,0,0,2"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="პროდუქტის ძებნა — შტრიხკოდი, კოდი ან დასახელება" />
                                        <TextBox Tag="CatalogProductSearch"
                                                 Padding="7,4"
                                                 Text="{Binding DataContext.ProductSearch.Query, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding DataContext.ProductSearch.EnterCommand, Source={x:Reference Root}}" />
                                                <KeyBinding Key="Up" Command="{Binding DataContext.ProductSearch.MoveUpCommand, Source={x:Reference Root}}" />
                                                <KeyBinding Key="Down" Command="{Binding DataContext.ProductSearch.MoveDownCommand, Source={x:Reference Root}}" />
                                                <KeyBinding Key="Escape" Command="{Binding DataContext.ProductSearch.ClearCommand, Source={x:Reference Root}}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            MinWidth="105"
                                            Padding="12,4"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding DataContext.ProductSearch.AddSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="დამატება"
                                            FontWeight="SemiBold" />

                                    <ListBox Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             MaxHeight="120"
                                             Margin="0,4,0,0"
                                             MouseDoubleClick="OnProductSearchResultDoubleClick"
                                             ItemsSource="{Binding DataContext.ProductSearch.Results, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             SelectedItem="{Binding DataContext.ProductSearch.SelectedProduct, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                             Visibility="{Binding DataContext.ProductSearch.HasResults, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinWidth="820" Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="165" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="75" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Code}" />
                                                    <TextBlock Grid.Column="1" Foreground="#5F6B7A" Text="{Binding Barcode, TargetNullValue=—}" />
                                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding MeasurementUnitShortName, TargetNullValue=—}" />
                                                    <TextBlock Grid.Column="4"
                                                               HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                                                               Text="{Binding Price, Converter={StaticResource DecimalDisplayConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="0,0,0,4"
                                    Padding="6"
                                    Background="#F8F9FB"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Margin="0,0,0,2" FontSize="11" Text="დასახელება" />
                                        <TextBox Tag="ManualProductName"
                                                 Padding="6,3"
                                                 MaxLength="300"
                                                 Text="{Binding DataContext.ManualItemInput.ProductName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock Margin="0,0,0,2" FontSize="11" Text="რაოდენობა" />
                                        <TextBox Padding="6,3"
                                                 IsReadOnly="{Binding DataContext.ManualItemInput.IsQuantityReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Text="{Binding DataContext.ManualItemInput.Quantity, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,6,0">
                                        <TextBlock Margin="0,0,0,2" FontSize="11" Text="ფასი" />
                                        <TextBox Padding="6,3"
                                                 IsReadOnly="{Binding DataContext.ManualItemInput.IsUnitPriceReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Text="{Binding DataContext.ManualItemInput.UnitPrice, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,6,0">
                                        <TextBlock Margin="0,0,0,2" FontSize="11" Text="ჯამი" />
                                        <TextBox Padding="6,3"
                                                 IsReadOnly="{Binding DataContext.ManualItemInput.IsLineTotalReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Text="{Binding DataContext.ManualItemInput.LineTotal, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,6,0">
                                        <TextBlock Margin="0,0,0,2" FontSize="11" Text="კომენტარი" />
                                        <TextBox Padding="6,3"
                                                 MaxLength="500"
                                                 Text="{Binding DataContext.ManualItemInput.Comment, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <CheckBox Grid.Row="0"
                                              Grid.Column="5"
                                              Margin="2,0,8,4"
                                              VerticalAlignment="Bottom"
                                              Content="კატალოგში"
                                              IsChecked="{Binding DataContext.ManualItemInput.SaveToCatalog, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                    <Button Grid.Row="0" Grid.Column="6"
                                            MinWidth="95"
                                            Padding="12,4"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding DataContext.AddManualItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="დამატება"
                                            FontWeight="SemiBold" />

                                    <Grid Grid.Row="1"
                                          Grid.ColumnSpan="7"
                                          Margin="0,5,0,0"
                                          Visibility="{Binding DataContext.ManualItemInput.IsCatalogDetailsVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="270" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Margin="0,0,0,2" FontSize="11" Text="ერთეული" />
                                            <ComboBox Padding="5,2"
                                                      DisplayMemberPath="DisplayName"
                                                      ItemsSource="{Binding DataContext.ManualItemInput.MeasurementUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding DataContext.ManualItemInput.SelectedMeasurementUnit, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Margin="0,0,0,2" FontSize="11" Text="კოდი" />
                                            <TextBox Padding="6,3"
                                                     MaxLength="50"
                                                     Text="{Binding DataContext.ManualItemInput.ProductCode, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                            <TextBlock Margin="0,0,0,2" FontSize="11" Text="შტრიხკოდი" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Padding="6,3"
                                                         MaxLength="100"
                                                         Text="{Binding DataContext.ManualItemInput.Barcode, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="1"
                                                        Width="30"
                                                        Margin="4,0,0,0"
                                                        Padding="4,2"
                                                        Command="{Binding DataContext.ManualItemInput.GenerateBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Content="↻"
                                                        ToolTip="შტრიხკოდის გენერაცია" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3"
                                                   Margin="2,0,0,2"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="#B42318"
                                                   FontSize="11"
                                                   Text="{Binding DataContext.ManualItemInput.CatalogMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DataContext.ManualItemInput.CatalogMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <DataGrid x:Name="SaleItemsGrid"
                                          ItemsSource="{Binding Items}"
                                          SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          ColumnHeaderHeight="26"
                                          EnableColumnVirtualization="True"
                                          EnableRowVirtualization="True"
                                          HeadersVisibility="Column"
                                          IsReadOnly="False"
                                          CellEditEnding="OnSaleItemCellEditEnding"
                                          PreviewMouseLeftButtonUp="OnSaleItemCellMouseUp"
                                          PreviewKeyDown="OnSaleItemsPreviewKeyDown"
                                          RowHeight="25"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectionMode="Single"
                                          SelectionUnit="CellOrRowHeader"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="90"
                                                            IsReadOnly="True"
                                                            SortMemberPath="ProductCode"
                                                            ElementStyle="{StaticResource TrimmedCellText}"
                                                            Header="კოდი"
                                                            Binding="{Binding ProductCode}" />
                                        <DataGridTextColumn Width="135"
                                                            IsReadOnly="True"
                                                            SortMemberPath="Barcode"
                                                            ElementStyle="{StaticResource TrimmedCellText}"
                                                            Header="შტრიხკოდი"
                                                            Binding="{Binding Barcode}" />
                                        <DataGridTextColumn Width="3*"
                                                            MinWidth="180"
                                                            IsReadOnly="True"
                                                            SortMemberPath="ProductName"
                                                            ElementStyle="{StaticResource TrimmedCellText}"
                                                            Header="დასახელება"
                                                            Binding="{Binding ProductName}" />
                                        <DataGridTextColumn Width="75"
                                                            IsReadOnly="True"
                                                            SortMemberPath="MeasurementUnitName"
                                                            ElementStyle="{StaticResource TrimmedCellText}"
                                                            Header="ერთეული"
                                                            Binding="{Binding MeasurementUnitName}" />
                                        <DataGridTextColumn Width="95"
                                                            ElementStyle="{StaticResource RightAlignedCellText}"
                                                            SortMemberPath="Quantity"
                                                            Header="რაოდენობა"
                                                            Binding="{Binding QuantityInput, Mode=TwoWay}" />
                                        <DataGridTextColumn Width="95"
                                                            ElementStyle="{StaticResource RightAlignedCellText}"
                                                            SortMemberPath="UnitPrice"
                                                            Header="ფასი"
                                                            Binding="{Binding UnitPriceInput, Mode=TwoWay}" />
                                        <DataGridTextColumn Width="105"
                                                            ElementStyle="{StaticResource RightAlignedCellText}"
                                                            SortMemberPath="LineTotal"
                                                            Header="ჯამი"
                                                            Binding="{Binding LineTotalInput, Mode=TwoWay}" />
                                        <DataGridTextColumn Width="2*"
                                                            MinWidth="120"
                                                            IsReadOnly="True"
                                                            SortMemberPath="Comment"
                                                            ElementStyle="{StaticResource TrimmedCellText}"
                                                            Header="კომენტარი"
                                                            Binding="{Binding Comment}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#7A8491"
                                           FontSize="17"
                                           IsHitTestVisible="False"
                                           Text="გაყიდვა ცარიელია">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Border Grid.Row="3"
                                    Margin="0,4,0,0"
                                    Padding="8,5"
                                    Background="#F8F9FB"
                                    CornerRadius="5">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button MinWidth="110"
                                                Margin="0,0,8,0"
                                                Padding="10,4"
                                                Command="{Binding DataContext.EditSelectedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="რედაქტირება (F2)" />
                                        <Button MinWidth="100"
                                                Padding="10,4"
                                                Command="{Binding DataContext.RemoveSelectedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="წაშლა (Delete)" />
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button MinWidth="110"
                                                Margin="0,0,8,0"
                                                Padding="12,6"
                                                Command="{Binding DataContext.PrintSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="ბეჭდვა" />
                                        <Button MinWidth="140"
                                                Margin="0,0,8,0"
                                                Padding="12,6"
                                                Command="{Binding DataContext.CancelSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="გაყიდვის გაუქმება" />
                                        <Button MinWidth="150"
                                                Margin="0,0,16,0"
                                                Padding="14,6"
                                                Background="#16794A"
                                                BorderBrush="#12683F"
                                                Command="{Binding DataContext.CompleteSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="გაყიდვის დასრულება"
                                                Foreground="White"
                                                FontWeight="SemiBold" />
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="105" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Margin="0,0,8,2" Text="პროდუქტების ჯამი" />
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                       Text="{Binding Subtotal, StringFormat={}{0:N2} ₾}" />
                                            <TextBlock Grid.Row="1" Margin="0,0,8,2" Text="ფასდაკლება" />
                                            <TextBox Grid.Row="1" Grid.Column="1"
                                                     Padding="5,2"
                                                     HorizontalContentAlignment="Right"
                                                     Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding DataContext.UpdateDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Grid.Row="2" Margin="0,3,8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Text="გადასახდელი" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3,0,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontSize="23"
                                                       FontWeight="Bold"
                                                       Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
                                        </Grid>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#7A8491"
                       FontSize="18"
                       IsHitTestVisible="False"
                       Text="ღია გაყიდვები არ არის">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OpenSales.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border Grid.Row="3"
                Padding="16,6"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Foreground="#5F6B7A"
                           Text="მონაცემები ინახება სერვერზე" />
                <TextBlock Foreground="#5F6B7A"
                           Text="{Binding OpenSales.Count, StringFormat=ღია გაყიდვები: {0}}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
