<UserControl x:Class="StorePos.Desktop.Sales.Views.SalesWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">
    <Grid Background="#F4F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,14"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        MinWidth="170"
                        Padding="16,9"
                        HorizontalAlignment="Right"
                        Command="{Binding NewSaleCommand}"
                        Content="+ ახალი გაყიდვა"
                        FontSize="15"
                        FontWeight="SemiBold" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="ღია გაყიდვები" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="18,10,18,0"
                   Foreground="#B42318"
                   FontSize="14"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="18,12,18,14">
            <TabControl ItemsSource="{Binding OpenSales}"
                        SelectedItem="{Binding SelectedSale}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,4">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding SaleNumber}" />
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="#5F6B7A"
                                       FontSize="11"
                                       Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="{Binding SaleNumber}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="#5F6B7A"
                                               Text="{Binding DateCreated, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="#5F6B7A"
                                               Text="{Binding CustomerName, TargetNullValue=მომხმარებელი მითითებული არ არის}" />
                                </StackPanel>
                            </DockPanel>

                            <GroupBox Grid.Row="1"
                                      Margin="0,0,0,14"
                                      Padding="12"
                                      Header="ხელით დამატება">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Margin="0,0,0,4" Text="დასახელება" />
                                        <TextBox Tag="ManualProductName"
                                                 Padding="7,5"
                                                 Text="{Binding DataContext.ManualProductName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Margin="0,0,0,4" Text="რაოდენობა" />
                                        <TextBox Padding="7,5"
                                                 Text="{Binding DataContext.ManualQuantity, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Margin="0,0,0,4" Text="ფასი" />
                                        <TextBox Padding="7,5"
                                                 Text="{Binding DataContext.ManualUnitPrice, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                        <TextBlock Margin="0,0,0,4" Text="კომენტარი (არასავალდებულო)" />
                                        <TextBox Padding="7,5"
                                                 Text="{Binding DataContext.ManualComment, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Button Grid.Column="4"
                                            MinWidth="110"
                                            Padding="15,7"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding DataContext.AddManualItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="დამატება"
                                            FontWeight="SemiBold" />
                                </Grid>
                            </GroupBox>

                            <Grid Grid.Row="2">
                                <DataGrid ItemsSource="{Binding Items}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*"
                                                            MinWidth="180"
                                                            Header="დასახელება"
                                                            Binding="{Binding ProductName}" />
                                        <DataGridTextColumn Width="110"
                                                            Header="რაოდენობა"
                                                            Binding="{Binding Quantity, StringFormat=N5}" />
                                        <DataGridTextColumn Width="110"
                                                            Header="ფასი"
                                                            Binding="{Binding UnitPrice, StringFormat=N5}" />
                                        <DataGridTextColumn Width="120"
                                                            Header="ჯამი"
                                                            Binding="{Binding LineTotal, StringFormat=N5}" />
                                        <DataGridTextColumn Width="2*"
                                                            Header="კომენტარი"
                                                            Binding="{Binding Comment}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#7A8491"
                                           FontSize="18"
                                           Text="გაყიდვა ცარიელია">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Border Grid.Row="3"
                                    Margin="0,14,0,0"
                                    Padding="16"
                                    Background="#F8F9FB"
                                    CornerRadius="6">
                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="18"
                                               Text="ჯამი:" />
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Text="{Binding TotalAmount, StringFormat={}{0:N2} ₾}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#7A8491"
                       FontSize="18"
                       Text="ღია გაყიდვები არ არის">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OpenSales.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border Grid.Row="3"
                Padding="18,8"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Foreground="#5F6B7A"
                           Text="მონაცემები ინახება სერვერზე" />
                <TextBlock Foreground="#5F6B7A"
                           Text="{Binding OpenSales.Count, StringFormat=ღია გაყიდვები: {0}}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
